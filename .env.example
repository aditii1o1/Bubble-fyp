# Shared Bubble environment
# Copy this file to `.env` in the repo root.

# Backend
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bubble
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_EMAILS=admin@example.com
REQUIRE_EMAIL_VERIFICATION=true
BACKEND_PUBLIC_URL=http://localhost:4000
BACKEND_PUBLIC_URLS=http://localhost:4000
APP_DEEPLINK_URL=bubble://

# Frontend public vars
EXPO_PUBLIC_API_URL=http://localhost:4000/api
# Optional: set `true` only when you want the dev app to ignore `EXPO_PUBLIC_API_URL`
# and auto-target a local backend on port 4000.
EXPO_PUBLIC_USE_LOCAL_API=false
EXPO_PUBLIC_KHALTI_ENV=TEST

# Optional: only needed if you later add Khalti's official native SDKs.
EXPO_PUBLIC_KHALTI_PUBLIC_KEY=test_public_key_replace_me

# Khalti backend vars
# `KHALTI_RETURN_URL` must be reachable from the device running Khalti checkout.
# `localhost` only works in a simulator/web setup; for a real phone, use your LAN IP or tunnel URL.
KHALTI_SECRET_KEY=test_secret_key_replace_me
KHALTI_WEBSITE_URL=http://localhost:4000
KHALTI_RETURN_URL=http://localhost:4000/payment/callback

# Optional mail settings
# Preferred on Render: Resend
RESEND_API_KEY=
# For quick testing you can use onboarding@resend.dev
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_TEST_TO=

# SMTP/Gmail fallback
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_SHOW_LOGO=true
EMAIL_LOGO_URL=

# Optional Cloudinary settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bubble
