## Bubble backend reads the shared root `.env` by default.
## Keep this file only if you need the legacy backend-only fallback.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bubble
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
ADMIN_EMAILS=admin@example.com
BACKEND_PUBLIC_URL=http://localhost:4000
APP_DEEPLINK_URL=Bubble://
KHALTI_SECRET_KEY=test_secret_key_replace_me
# `KHALTI_RETURN_URL` must be reachable from the device running Khalti checkout.
# `localhost` only works in a simulator/web setup; for a real phone, use your LAN IP or tunnel URL.
KHALTI_WEBSITE_URL=http://localhost:4000
KHALTI_RETURN_URL=http://localhost:4000/payment/callback
