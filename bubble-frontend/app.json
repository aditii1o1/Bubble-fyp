{
  "expo": {
    "scheme": "bubble",
    "name": "Bubble",
    "slug": "Bubble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "bubble",
              "host": "donate",
              "pathPrefix": "/result"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.aditibubble.bubble"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bubble to access your photos so you can set a profile picture."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://bubble-fyp.onrender.com/api",
      "khaltiPublicKey": "",
      "khaltiEnv": "TEST",
      "backendPublicUrl": "https://bubble-fyp.onrender.com",
      "appDeeplinkUrl": "bubble://",
      "router": {},
      "eas": {
        "projectId": "6f3c5f83-0dfc-4333-aa34-6dee4fa27826"
      }
    }
  }
}
